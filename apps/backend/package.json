    "db:studio": "cd ../../packages/db && pnpm db:studio"
  },
  "dependencies": {
    "@google/genai": "^1.33.0",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "@omniknight/db": "workspace:*",
    "@omniknight/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "input": "^1.0.1",
    "openai": "^4.77.3",
    "telegram": "^2.25.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
